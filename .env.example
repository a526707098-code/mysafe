# PRIVATE VAULT — copy to .env and replace EVERY value.
#   cp .env.example .env && ./scripts/generate-secrets.sh >> .env   (then delete the duplicates below)
# The API refuses to start while any secret below is missing or still a placeholder.
# Never commit .env. Keep an offline copy: without ENCRYPTION_KEY the data cannot be decrypted.

NODE_ENV=production

# Where the UI is reached from (exact origin; used for CSRF/Origin checks).
APP_ORIGIN=https://vault.example.ts.net
# Must be true whenever the vault is reached over HTTPS (always, except local testing).
COOKIE_SECURE=true

# Bind address/port for nginx on the host. Keep 127.0.0.1 unless you bind a Tailscale IP.
VAULT_BIND=127.0.0.1
VAULT_PORT=8080

# --- PostgreSQL (dedicated instance for this project only) ---
# Superuser: used only by the database container itself (init, backups).
POSTGRES_ADMIN_USER=vault_admin
POSTGRES_ADMIN_PASSWORD=change-me
# Application role: owns private_vault, cannot reach any other database.
POSTGRES_DB=private_vault
POSTGRES_USER=private_vault_user
POSTGRES_PASSWORD=change-me

# --- Secrets (generate with scripts/generate-secrets.sh) ---
# 32+ random characters each, all different.
APP_SECRET=change-me
SESSION_SECRET=change-me
# 32 random bytes, base64. Encrypts vault data. NOT stored in the database.
ENCRYPTION_KEY=change-me
ENCRYPTION_KEY_VERSION=1
# Only during a key rotation: the previous ENCRYPTION_KEY (see docs/SECURITY.md).
ENCRYPTION_KEY_PREVIOUS=
# 32 random bytes, base64. Encrypts TOTP secrets; must differ from ENCRYPTION_KEY.
TOTP_ENCRYPTION_KEY=change-me
# Encrypts backup archives (see docs/BACKUP.md). Store a copy offline.
BACKUP_PASSPHRASE=change-me

# --- Behaviour ---
SESSION_IDLE_MINUTES=15
SESSION_ABSOLUTE_HOURS=12
TRASH_RETENTION_DAYS=30
# Leave false. Storing CVV codes is strongly discouraged.
ALLOW_CVV_STORAGE=false
